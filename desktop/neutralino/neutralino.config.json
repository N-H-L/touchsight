{
  "applicationId": "org.hunsakerweb.touchsightng",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "exportAuthInfo": false,
  "singlePageServe": false,
  "enableServer": false,
  "enableNativeAPI": false,
  "enableExtensions": false,
  "url": "http://localhost:5173/",
  "modes": {
    "window": {
      "title": "TouchSight-NG",
      "width": 1280,
      "height": 800,
      "minWidth": 640,
      "minHeight": 480,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "touchsight-ng",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.3.0",
    "clientVersion": "6.3.0"
  }
}
